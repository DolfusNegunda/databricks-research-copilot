# Local development template. Copy to .env and fill in.
#
#   cp env.example .env
#
# .env is git-ignored. Never commit a real connection string -- in the
# workspace it lives only in a Databricks secret scope, and app.yaml refers
# to it by name.

# ---------------------------------------------------------------- Lakebase --
LAKEBASE_URL=postgresql://USER:PASSWORD@INSTANCE.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# Where the app looks for that DSN when LAKEBASE_URL is unset. These are the
# defaults; matches app/app.yaml and mcp_server/app.yaml.
# LAKEBASE_SECRET_SCOPE=database
# LAKEBASE_SECRET_KEY=lakebase-url

# Schema this project's tables live in. Defaults to "research", not "public",
# so it can share a Lakebase instance with another bootcamp project with zero
# risk of a table-name collision. Created automatically if missing.
# LAKEBASE_SCHEMA=research

# No static password anywhere: leave LAKEBASE_URL unset, give a host, and the
# app mints a short-lived credential from its own Databricks identity.
# PGHOST=INSTANCE.database.cloud.databricks.com
# PGUSER=you@example.com
# LAKEBASE_INSTANCE_NAME=INSTANCE

# ------------------------------------------------------------------ OpenAlex --
# Keyless, polite-pool API -- mailto identifies you to OpenAlex's rate
# limiter; no account or key needed. https://developers.openalex.org/
OPENALEX_MAILTO=you@example.com

# Where harvester/snowball.py writes landed JSON Lines (local path for a
# manual run; a UC Volume path, e.g. /Volumes/main/research_copilot/raw, when
# run as the Databricks job in resources/openalex_harvest_job.yml).
# OPENALEX_HARVEST_DIR=./harvest

# ------------------------------------------------------------- Embeddings --
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=384
# SENTENCE_TRANSFORMERS_HOME=.cache/sentence-transformers

# ----------------------------------------------- Optional: Agent Bricks / FM --
# Serving endpoint name for the Agent Bricks agent (see docs/agent_bricks_setup.md).
# Unset until the agent is created; app/app.py's /api/agent/chat degrades to a
# clear "agent_not_configured" response rather than 500ing until this is set.
# AGENT_SERVING_ENDPOINT=your-agent-bricks-endpoint-name

# ------------------------------------------------------------------ Server --
# FLASK_RUN_HOST=0.0.0.0
# FLASK_RUN_PORT=8000

# MCP server (mcp_server/) -- separate Databricks App, own port.
# DATABRICKS_APP_PORT=8001
